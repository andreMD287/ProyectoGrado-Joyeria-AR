# Plataforma mínima del proyecto: iOS 16.0
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  # Requerido por ar_flutter_plugin_2 (headers modulares de ARKit)
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # MediaPipe Tasks para el cuello de los collares (NeckTrackingHandler.swift).
  # En CocoaPods no está la 0.10.29 que usa Android.
  #
  # Historial de versiones probadas (crash de arranque con EXC_BAD_ACCESS en
  # mediapipe::GlobalFactoryRegistry con 0.10.21, por choque de símbolos C++
  # — abseil/protobuf empotrados — contra los pods de ML Kit que ya usa el
  # resto de la app):
  # - 0.10.21: crash de arranque (registro global).
  # - 1.0.0: el crash de arranque desaparece (abseil interno actualizado de
  #   oct-2023 a ene-2025), pero compila y crashea distinto, dentro de
  #   `FaceLandmarker(options:)` — posible cambio de comportamiento de
  #   `FaceLandmarkerOptions` por el salto grande de versión.
  # - 0.10.35: probando como punto intermedio, más cerca de 1.0.0 en abseil
  #   pero sin el salto completo de ruptura de API de la 1.0.0.
  pod 'MediaPipeTasksVision', '0.10.35'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      # CRÍTICO: permission_handler deshabilita todos los permisos por defecto
      # en iOS. Sin esta macro, el permiso de cámara ni siquiera se compila y
      # el diálogo del sistema nunca aparece.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=1',
      ]
    end
  end
end
